name: Workflow to check status

on: 
  push:
    branches:
      - master 

jobs:
  check-status:
    runs-on: ubuntu-latest
    steps:
      - name: Primer paso correcto..
        run: echo "Hello world..."

      - name: Paso que falla
        run: exit 1

      - name: Step después del error (solo si el anterior fue exitoso)
        if: success()
        run: echo "Este mensaje NO aparecerá porque el paso anterior falló"

      - name: Step después del error (solo si el anterior falló)
        if: failure()
        run: echo "El paso anterior falló. Este mensaje sí aparecerá."

      - name: Step que siempre se ejecuta
        if: always()
        run: echo "Este mensaje aparece siempre, sin importar si falló o no."
